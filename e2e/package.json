{
  "name": "@remixclip/e2e",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "RemixClip 视觉回归：Playwright 截图 + pixelmatch 基线比对",
  "scripts": {
    "visual": "playwright test -c playwright.config.ts",
    "visual:record": "VISUAL_UPDATE=1 playwright test -c playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@remixclip/contracts": "workspace:*",
    "@types/node": "20.19.39",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
